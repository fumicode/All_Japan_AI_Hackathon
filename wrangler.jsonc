{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",

  "name": "all-japan-ai-hackathon",
  "compatibility_date": "2026-11-06",

  // API ルート本体
  "main": "src/index.js",

  "assets": {
    "directory": "./public",

    // Worker から静的アセットを返すためのバインディング(env.ASSETS)
    "binding": "ASSETS",

    // 存在しないパスで index.html を返す(SPA向け)
    "not_found_handling": "single-page-application",

    // /api/* は静的アセットより先に Worker へ渡す。
    // これがないと SPA フォールバックが /api/chat を飲み込む。
    "run_worker_first": ["/api/*"]
  }
}
